---
import ThemeSwitcher from './ThemeSwitcher.astro'
import IconRss from './icons/IconRss.astro'
---

<header>
  <section>
    <a href="/">
      <h1>Vortex</h1>
    </a>
    <ThemeSwitcher />
  </section>

  <nav>
    <ul>
      <li><a href="/post">文章</a></li>
      <li><a href="/about">关于</a></li>
      <li><a href="/rss.xml"><IconRss /></a></li>
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    font-weight: bold;

    height: 48px;
    margin-bottom: 24px;
  }

  section {
    display: flex;
    gap: 8px;
  }

  nav {
    ul {
      display: flex;
      gap: 1.5rem;

      list-style-type: none;
      padding-inline-start: unset;
      margin-block: unset;
    }

    a:hover {
      opacity: 0.7;
    }
  }
</style>
