---
import ThemeSwitcher from './ThemeSwitcher.astro'
---

<header>
  <section>
    <a href="/">
      <h1>Vortex's blog</h1>
    </a>
    <ThemeSwitcher />
  </section>

  <nav>
    <ul>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    height: 48px;
    margin-bottom: 24px;
  }

  section {
    display: flex;
    gap: 8px;

    h1 {
      font-weight: bold;
    }
  }

  nav {
    ul {
      list-style-type: none;
      padding-inline-start: unset;
      margin-block: unset;
    }
  }
</style>
