---
import type { CollectionEntry } from 'astro:content'
import { countMixed } from '../utils'

interface Props {
  post: CollectionEntry<'blog'>
  history?: boolean
}

const { post, history = false } = Astro.props

const formater = Intl.DateTimeFormat('zh', {
  dateStyle: 'medium',
})
---

<div class="meta">
  <time datetime={post.data.pubDate.toISOString()}>
    {formater.format(post.data.pubDate)}
  </time>
  <span>{countMixed(post.body ?? '')}字</span>
  {
    history && (
      <a
        href={`https://github.com/realloon/blog/commits/main/${post.filePath}`}
      >
        修订历史
      </a>
    )
  }
</div>

<style>
  .meta {
    font-size: 0.875rem;
    line-height: 1;
    color: var(--color-muted);

    & > *:not(:last-child)::after {
      content: '·';
      padding-inline: 0.5em;
    }
  }
</style>
