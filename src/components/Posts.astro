---
import { getCollection } from 'astro:content'
import { formater } from '../utils'

const posts = await getCollection('blog')
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<div>
  {
    posts.map(post => (
      <section>
        <h2>
          <a href={`/post/${post.id}`} data-astro-prefetch>
            {post.data.title}
          </a>
        </h2>
        <time datetime={post.data.pubDate.toISOString()}>
          {formater.format(post.data.pubDate)}
        </time>
      </section>
    ))
  }
</div>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h2 {
    font-size: 1.125rem;
    font-weight: bold;
  }

  time {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
