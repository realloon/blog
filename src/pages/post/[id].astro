---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import PostMeta from '../../components/PostMeta.astro'
import IconBack from '../../components/icons/IconBack.astro'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const siteUrl = Astro.site!
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '主页',
      item: new URL('/', siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '文章',
      item: new URL('/post', siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: new URL(Astro.url.pathname, siteUrl).href,
    },
  ],
}

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }))
}
---

<Layout title={post.data.title}>
  <article>
    <header>
      <nav>
        <ol>
          <li><a href="/">主页</a></li>
          <li><a href="/post">Posts</a></li>
        </ol>
      </nav>
      <h1>{post.data.title}</h1>
      <PostMeta post={post} history />
    </header>

    <Content />
  </article>

  <a class="back" href="/">
    <IconBack />
    <span>返回</span>
  </a>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb).replace(/</g, '\\u003c')}
  />
</Layout>

<style>
  header {
    margin-bottom: 1rem;

    h1 {
      font-size: 1.75rem;
      line-height: 1.25;
    }
  }

  nav > ol {
    display: flex;

    line-height: 1;
    padding-inline-start: unset;
    list-style-type: none;

    li:not(:last-of-type)::after {
      content: '»';
      display: inline-block;
      font-size: 0.875rem;
      vertical-align: top;
      margin-inline: 0.75em;
    }
  }

  .back {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;

    margin-block: 4rem 2rem;

    transition: 0.2s;
    opacity: 0.5;

    &:hover {
      opacity: 1;
    }
  }
</style>
