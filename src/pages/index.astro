---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import PostMeta from '../components/PostMeta.astro'
import IconGithub from '../components/icons/IconGithub.astro'

const posts = await getCollection('blog')
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<Layout>
  <section class="hero">
    <strong>hello.</strong>
    <address>
      <a href="https://github.com/realloon" aria-label="github">
        <IconGithub />
      </a>
    </address>
  </section>

  <div class="posts">
    {
      posts.map(post => (
        <section>
          <h2>
            <a href={`/post/${post.id}`} data-astro-prefetch>
              {post.data.title}
            </a>
          </h2>
          <PostMeta post={post} />
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;

    margin-top: calc(16dvh - 24px);
    margin-bottom: 16dvh;

    strong {
      font-size: 2rem;
    }

    address {
      display: flex;
      gap: 1rem;
    }
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;

    section {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    h2 {
      font-size: 1.125rem;
      font-weight: bold;
    }

    time {
      font-size: 0.875rem;
      color: var(--color-muted);
    }
  }
</style>
