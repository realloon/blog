---
import Layout from '../layouts/Layout.astro'
import Posts from '../components/Posts.astro'
import IconGithub from '../components/icons/IconGithub.astro'
---

<Layout>
  <section class="hero">
    <strong>hello.</strong>
    <address>
      <a href="https://github.com/realloon" aria-label="github">
        <IconGithub />
      </a>
    </address>
  </section>

  <Posts />
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;

    margin-top: calc(16dvh - 24px);
    margin-bottom: 16dvh;

    strong {
      font-size: 2rem;
    }

    address {
      display: flex;
      gap: 1rem;
    }
  }
</style>
