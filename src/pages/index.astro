---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import PostMeta from '../components/PostMeta.astro'
import IconGithub from '../components/icons/IconGithub.astro'

const posts = await getCollection('blog')
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

function excerpt(markdown: string) {
  return markdown
    .replace(/## \S+\n/g, '')
    .replace(/!\[[^\]]*\]\(\S*\)/g, '[图片]')
    .replace(/\s\s+/g, '')
    .slice(0, 140)
}
---

<Layout>
  <section class="hero">
    <strong>hello.</strong>
    <address>
      <a href="https://github.com/realloon" aria-label="github">
        <IconGithub />
      </a>
    </address>
  </section>

  <div class="posts">
    {
      posts.map(post => (
        <section>
          <a href={`/post/${post.id}`} data-astro-prefetch>
            <h2>{post.data.title}</h2>
            <p>{excerpt(post.body ?? '')}</p>
          </a>
          <PostMeta post={post} />
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;

    margin-top: calc(16dvh - 24px);
    margin-bottom: 16dvh;

    strong {
      font-size: 2rem;
    }

    address {
      display: flex;
      gap: 1rem;
    }
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;

    section {
      display: flex;
      flex-direction: column;
      gap: 8px;

      h2 {
        font-size: 1.25rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
      }

      p {
        color: var(--color-muted);
        line-height: 1.5;

        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
      }
    }
  }
</style>
