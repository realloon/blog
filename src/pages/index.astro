---
import Layout from '../layouts/Layout.astro'
import Posts from '../components/Posts.astro'
import IconGithubLine from '../components/icons/IconGithubLine.astro'
---

<Layout description="Realloon 的博客网站，记录个人实践与思考。">
  <section class="hero">
    <h1>hello.</h1>
    <address>
      <a href="https://github.com/realloon" aria-label="github">
        <IconGithubLine />
      </a>
    </address>
  </section>

  <Posts />
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;

    margin-top: calc(16dvh - 24px);
    margin-bottom: 16dvh;

    h1 {
      font-size: 2rem;
    }

    address {
      display: flex;
      gap: 1rem;
    }
  }
</style>
